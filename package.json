{
  "name": "graph-prime",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "cargo test --release --locked --manifest-path src-tauri/Cargo.toml",
    "build:linux": "tauri build --bundles appimage,deb,rpm && bash scripts/fix-appimage.sh src-tauri/target/release/bundle/appimage/*.AppImage",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/cli": "~2.11.4",
    "@tauri-apps/plugin-clipboard-manager": "2.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/dygraphs": "^2.1.11",
    "codemirror": "^6.0.2",
    "dygraphs": "^2.2.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "frappe-charts": "^1.6.2",
    "globals": "^17.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-fa": "^4.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.0"
}
