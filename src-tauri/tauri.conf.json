{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../public",
    "devUrl": "http://localhost:8080"
  },
  "bundle": {
    "active": true,
    "category": "Education",
    "copyright": "DoodlesEpic",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "Cross-platform prime number calculator developed on Tauri and Svelte with beautiful frappe graphs and excellent performance",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "Prime number calculator",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "productName": "Graph Prime",
  "mainBinaryName": "Graph Prime",
  "version": "2.0.0",
  "identifier": "dev.doodles.graphprime",
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 600,
        "resizable": true,
        "title": "Graph Prime Calculator",
        "width": 800,
        "useHttpsScheme": true
      }
    ]
  }
}
